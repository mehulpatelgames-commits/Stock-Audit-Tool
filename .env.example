# Environment Variables — PIL Stock Audit
# Copy this file to .env and fill in your values

# PostgreSQL (auto-filled by Railway when you add a Postgres plugin)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Google Service Account JSON (for Drive photo uploads)
# Paste the entire JSON content as a single line string
GOOGLE_SA_JSON={"type":"service_account","project_id":"..."}

# Google Drive Folder ID where photos will be uploaded
DRIVE_FOLDER_ID=your_drive_folder_id_here

# Secret key for session tokens (generate a random string)
SECRET_KEY=your-random-secret-key-here

# Comma-separated list of names who have admin access
ADMIN_NAMES=Jay Samani,Admin
